#!/usr/bin/env python3

import apprentice as app
import numpy as np


if __name__ == "__main__":

    import optparse, os, sys, h5py
    op = optparse.OptionParser(usage=__doc__)
    op.add_option("-v", "--debug", dest="DEBUG", action="store_true", default=False, help="Turn on some debug messages")
    op.add_option("-o", dest="OUTPUT", default="approx.json", help="Output filename (default: %default)")
    op.add_option("-w", dest="WEIGHTS", default=None, help="Obervable file (default: %default)")
    op.add_option("-s", dest="SEED", type=int, default=1234, help="Random seed (default: %default)")
    op.add_option("--order", dest="ORDER", default=None, help="Polynomial orders of numerator and denominator, comma separated (default: %default)")
    op.add_option("--mode", dest="MODE", default="sip", help="Base algorithm  --- la |sip|lasip --- (default: %default)")
    op.add_option("--errs", dest="ERRS", action='store_true', default=False, help="Build approximations for errors, (default is for values)")
    op.add_option("--log", dest="ISLOG", action='store_true', default=False, help="input data is logarithmic --- affects how we filter (default: %default)")
    op.add_option("--ftol", dest="FTOL", type=float, default=1e-9, help="ftol for SLSQP (default: %default)")
    op.add_option("--pname", dest="PNAME", default="params.dat", help="Name of the params file to be found in each run directory (default: %default)")
    op.add_option("--itslsqp", dest="ITSLSQP", type=int, default=200, help="maxiter for SLSQP (default: %default)")
    op.add_option("--msg", dest="MSGEVERY", default=5, type=int, help="Verbosity of progress (default: %default)")
    op.add_option("-t", "--testpoles", dest="TESTPOLES", type=int, default=10, help="Number of multistarts for pole detection (default: %default)")
    op.add_option("--convert", dest="CONVERTINPUT", default=None, help="Option to store input data as hdf, needs argument (default: %default)")
    op.add_option("--min-ess", dest="MINESS", type=float, default=0., help="Drop bins unless their effective sample size (value/error)^2 reaches this, 0 disables (default: %default)")
    op.add_option("--min-ess-frac", dest="MINESSFRAC", type=float, default=1.0, help="Fraction of a bin's runs that must reach --min-ess for the bin to be kept (default: %default)")

    og = optparse.OptionGroup(op, "Validation", "Hold back part of the grid, then check the surrogates against it. --training-size switches all of this on.")
    og.add_option("--training-size", dest="TRAININGSIZE", type=float, default=None, help="Use this many grid points (fraction of the grid if < 1) to build the surrogates, validate them on the ones held back (default: %default)")
    og.add_option("--validation-measure", dest="VALIDATIONMEASURE", default="1", help="mean or the n-th largest (default: %default)")
    og.add_option("--validation-dir", dest="VALIDATIONDIR", default=None, help="Validate on the runs in this directory instead of on the held back ones (default: %default)")
    og.add_option("--validation-plot-per-bin", dest="VALPLOTPERBIN", action="store_true", default=False, help="Additionally plot model output vs surrogate prediction for every single bin (default: %default)")
    og.add_option("--validation-output", dest="VALIDATIONOUTPUT", default="validation", help="Directory for the validation plots and the deviation list (default: %default)")
    og.add_option("--validation-log", dest="VALIDATIONLOG", action="store_true", default=False, help="Use logarithmic axes for the scatter colour scale and the distribution x axis")
    op.add_option_group(og)
    opts, args = op.parse_args()

    rank=0
    size=1
    try:
        from mpi4py import MPI
        comm = MPI.COMM_WORLD
        size = comm.Get_size()
        rank = comm.Get_rank()
    except Exception as e:
        print("Exception when trying to import mpi4py:", e)
        comm = None
        pass

    if opts.MODE not in ["la", "sip", "lasip"]:
        print("Error: specified mode {} not known".format(opts.MODE))
        sys.exit(1)

    if opts.VALIDATIONMEASURE != "mean" and not (opts.VALIDATIONMEASURE.isdigit() and int(opts.VALIDATIONMEASURE) > 0):
        print("Error: specified validation measure {} not known, use mean or a positive integer".format(opts.VALIDATIONMEASURE))
        sys.exit(1)

    if opts.VALIDATIONDIR is not None:
        if opts.TRAININGSIZE is None:
            print("Error: --validation-dir requires --training-size")
            sys.exit(1)
        if not os.path.isdir(opts.VALIDATIONDIR):
            print("Error: validation directory {} not found".format(opts.VALIDATIONDIR))
            sys.exit(1)

    if opts.VALPLOTPERBIN and opts.TRAININGSIZE is None:
        print("Error: --validation-plot-per-bin requires --training-size")
        sys.exit(1)

    if len(args) == 0:
        print("No input specified, exiting")
        sys.exit(1)

    if not os.path.exists(args[0]):
        print("Input '{}' not found, exiting.".format(args[0]))
        sys.exit(1)

    # Prevent overwriting of input data
    assert(args[0]!=opts.OUTPUT)

    # Data loading and distribution of work
    if os.path.isfile(args[0]):
        DATA, binids, pnames, rankIdx, xmin, xmax = app.io.readInputDataH5(args[0], opts.WEIGHTS)
    elif os.path.isdir(args[0]):
        # YODA directory parsing here
        DATA, binids, pnames, rankIdx, xmin, xmax = app.io.readInputDataYODA(args, opts.PNAME, opts.WEIGHTS, storeAsH5=opts.CONVERTINPUT)
    else:
        print("{} neither directory nor file, exiting".format(args[0]))
        exit(1)

    ESSKEEP = app.tools.selectBinsByESS(DATA, opts.MINESS, opts.MINESSFRAC) if opts.MINESS > 0 else None
    if ESSKEEP is not None:
        KEPT, TOTAL = comm.gather(int(np.sum(ESSKEEP)), root=0), comm.gather(len(ESSKEEP), root=0)
        if rank==0:
            nk, nt = sum(KEPT), sum(TOTAL)
            print("Effective sample size filter: dropped {}/{} bins without {:g}% of their runs at ESS >= {:g}".format(nt-nk, nt, 100*opts.MINESSFRAC, opts.MINESS))
            sys.stdout.flush()

    comm.barrier()
    print("[{}] will proceed to calculate approximations for {} objects".format(rank, len(DATA) if ESSKEEP is None else int(np.sum(ESSKEEP))))
    sys.stdout.flush()

    DEVTHRESHOLD = 3.
    VALX, TRAINX = app.tools.splitGridPoints(DATA, opts.TRAININGSIZE, opts.SEED, comm) if opts.TRAININGSIZE is not None else (None, None)
    VALDIR = os.path.join(os.path.dirname(opts.OUTPUT), opts.VALIDATIONOUTPUT)
    GRIDPATHS = app.io.readGridPointPaths(args, opts.PNAME, pnames, comm) if opts.TRAININGSIZE is not None else None
    if GRIDPATHS is not None and opts.VALIDATIONDIR is not None:
        GRIDPATHS.update(app.io.readGridPointPaths([opts.VALIDATIONDIR], opts.PNAME, pnames, comm))
    VALDATA, VALP = None, VALX
    if VALX is not None and opts.VALIDATIONDIR is not None:
        VALDATA, VALP = app.io.readValidationDataYODA(opts.VALIDATIONDIR, opts.PNAME, opts.WEIGHTS, pnames, comm)
        if ESSKEEP is not None:
            VKEYS = list(VALDATA.keys())
            VKEEP = dict(zip(VKEYS, app.tools.selectBinsByESS([list(VALDATA[k]) for k in VKEYS], opts.MINESS, opts.MINESSFRAC)))
            ndrop = 0
            for num in range(len(DATA)):
                if ESSKEEP[num] and not VKEEP.get(binids[num], True):
                    ESSKEEP[num] = False
                    ndrop += 1
            NDROP = comm.gather(ndrop, root=0)
            if rank==0 and sum(NDROP) > 0:
                print("Effective sample size filter: dropped a further {} bins on the runs from {}".format(sum(NDROP), opts.VALIDATIONDIR))
                sys.stdout.flush()
    if VALX is not None:
        valdev = [[] for x in VALP]
        valbad = []
        traindev = [[] for x in TRAINX]
        valpull, trainpull = [], []
        os.makedirs(VALDIR, exist_ok=True)
        if rank==0:
            print("Building the surrogates from {} of the grid points, holding back {} for validation".format(len(TRAINX), len(VALX)))
            if VALDATA is not None:
                print("Validating on {} runs from {}".format(len(VALP), opts.VALIDATIONDIR))
            if opts.VALPLOTPERBIN:
                print("Validation: writing one model vs surrogate plot per bin into {}".format(VALDIR))
            sys.stdout.flush()

    apps = []
    M, N = [int(x) for x in opts.ORDER.split(",")]

    import time
    t4   = time.time()
    import datetime
    binedges = {}
    dapps = {}
    for num, (X, Y, E) in  enumerate(DATA):
        thisBinId = binids[num]

        if rank==0 or rank==size-1:
            if ((num+1)%opts.MSGEVERY ==0):
                now = time.time()
                tel = now - t4
                ttg = tel*(len(DATA)-num)/(num+1)
                eta = now + ttg
                eta = datetime.datetime.fromtimestamp(now + ttg)
                sys.stdout.write("{}[{}] {}/{} (elapsed: {:.1f}s, to go: {:.1f}s, ETA: {})\r".format(80*" " if rank>0 else "", rank, num+1, len(DATA), tel, ttg, eta.strftime('%Y-%m-%d %H:%M:%S')) ,)
                sys.stdout.flush()
        if ESSKEEP is not None and not ESSKEEP[num]: continue

        # USE = np.where( (_Y>0) ) if opts.ISLOG else np.where( (_E>=0) )
        # from IPython import embed
        # embed()
        # X = _X[USE, :]
        # Y =  np.log10(_Y[USE]) if opts.ISLOG else _Y[USE]
        # E =  np.log10(_E[USE]) if opts.ISLOG else _E[USE]

        if VALX is not None:
            IV    = app.tools.validationIndex(X, VALX)
            isval = IV >= 0
            XV, YV, EV, IV = X[isval], Y[isval], E[isval], IV[isval]
            X, Y, E = X[~isval], Y[~isval], E[~isval]
            if VALDATA is not None:
                XV, YV, EV = VALDATA.get(thisBinId, (np.zeros((0, len(pnames))), np.zeros(0), np.zeros(0)))
                IV = app.tools.validationIndex(XV, VALP)

        if len(X) == 0:
            print("No data to calculate approximation for {} --- skipping".format(thisBinId))
            import sys
            sys.stdout.flush()
            continue
        if len(X) < app.tools.numCoeffsRapp(len(X[0]),order=(M,N)):
            print("Not enough data ({} vs {}) to calculate approximation for {} --- skipping".format(len(X), app.tools.numCoeffsRapp(len(X[0]), order=(M,N)), thisBinId))
            import sys
            sys.stdout.flush()
            continue

        if opts.ERRS:
            temp,  hasPole = app.tools.calcApprox(X, E, (M,N), pnames, opts.MODE, debug=opts.DEBUG, testforPoles=opts.TESTPOLES, ftol=opts.FTOL, itslsqp=opts.ITSLSQP)
            vmin = np.min(E)
            vmax = np.max(E)
        else:
            temp,  hasPole = app.tools.calcApprox(X, Y, (M,N), pnames, opts.MODE, debug=opts.DEBUG, testforPoles=opts.TESTPOLES, ftol=opts.FTOL, itslsqp=opts.ITSLSQP)
            vmin = np.min(Y)
            vmax = np.max(Y)
        if temp is None:
            print("Unable to calculate value approximation for {} --- skipping".format(thisBinId))
            import sys
            sys.stdout.flush()
            continue
        else:
            if hasPole:
                print("Warning: pole detected in {}".format(thisBinId))
                import sys
                sys.stdout.flush()
        temp._vmin = vmin
        temp._vmax = vmax
        temp._xmin = xmin[num]
        temp._xmax = xmax[num]
        apps.append((temp, xmin[num], xmax[num]))
        dapps[thisBinId]= temp.asDict
        binedges[thisBinId] = (xmin[num], xmax[num])

        if VALX is not None and len(XV) > 0:
            REF = EV if opts.ERRS else YV
            for nv, xv in enumerate(XV):
                pred   = temp(xv)
                absdev = abs(pred - REF[nv])
                den    = REF[nv] if opts.ERRS else EV[nv]
                if den == 0: continue
                dev  = (REF[nv] - pred)/REF[nv] if opts.ERRS else absdev/EV[nv]
                pull = (pred - REF[nv])/den
                if not np.isfinite(dev) or not np.isfinite(pull): continue
                reldev = absdev/abs(REF[nv]) if REF[nv] != 0 else np.nan
                if abs(dev) > DEVTHRESHOLD: valbad.append((thisBinId, IV[nv], dev, absdev, reldev, EV[nv]))
                valdev[IV[nv]].append(dev)
                valpull.append(pull)

            IT   = app.tools.validationIndex(X, TRAINX)
            TREF = E if opts.ERRS else Y
            for nt, xt in enumerate(X):
                if IT[nt] < 0: continue
                pred = temp(xt)
                den  = TREF[nt] if opts.ERRS else E[nt]
                if den == 0: continue
                dev  = (TREF[nt] - pred)/TREF[nt] if opts.ERRS else abs(pred - TREF[nt])/E[nt]
                pull = (pred - TREF[nt])/den
                if not np.isfinite(dev) or not np.isfinite(pull): continue
                traindev[IT[nt]].append(dev)
                trainpull.append(pull)

        if VALX is not None and opts.VALPLOTPERBIN:
            PT = np.array([temp(x) for x in X])
            PV = np.array([temp(x) for x in XV]) if len(XV) > 0 else np.zeros(0)
            app.tools.plotBinValidation(thisBinId, os.path.join(VALDIR, "bin_{}.pdf".format(app.tools.safeFileName(thisBinId))),
                                        E if opts.ERRS else Y, PT, None if opts.ERRS else E,
                                        EV if opts.ERRS else YV, PV, None if opts.ERRS else EV,
                                        nsigma=DEVTHRESHOLD)


    DAPPS = comm.gather(dapps, root=0)
    DEDGE = comm.gather(binedges, root=0)
    VALDEV = comm.gather(valdev, root=0) if VALX is not None else None
    VALBAD = comm.gather(valbad, root=0) if VALX is not None else None
    TRAINDEV = comm.gather(traindev, root=0) if VALX is not None else None
    VALPULL = comm.gather(valpull, root=0) if VALX is not None else None
    TRAINPULL = comm.gather(trainpull, root=0) if VALX is not None else None
    t5   = time.time()
    if rank==0:
        print()
        print("Approximation calculation took {} seconds".format(t5-t4))
        sys.stdout.flush()

        # Store in JSON
        from collections import OrderedDict
        JD = OrderedDict()

        a, e = {}, {}
        for apps in DAPPS:
            a.update(apps)

        for edges in DEDGE:
            e.update(edges)

        xmin, xmax = [], []
        for k in a.keys():
            xmin.append(e[k][0])
            xmax.append(e[k][1])
            JD[k] = a[k]
        # TODO delete __xmin __xmax
        JD["__xmin"]=xmin
        JD["__xmax"]=xmax

        import json
        class NumpyFloatValuesEncoder(json.JSONEncoder):
           def default(self, obj):
              if isinstance(obj, np.float32):
                 return float(obj)
              return json.JSONEncoder.default(self, obj)

        with open(opts.OUTPUT, "w") as f: json.dump(JD, f, indent=4, cls=NumpyFloatValuesEncoder)

        print("Done --- {} approximations written to {}".format(len(JD), opts.OUTPUT))

        if VALX is not None:
            DEV = [sum([v[iv] for v in VALDEV], []) for iv in range(len(VALP))]
            USE = [iv for iv in range(len(VALP)) if len(DEV[iv]) > 0]
            if len(USE) == 0:
                print("No validation data available, skipping validation plots")
            else:
                V   = np.array([app.tools.validationMeasure(DEV[iv], opts.VALIDATIONMEASURE) for iv in USE])
                D   = np.concatenate([DEV[iv] for iv in USE])
                BAD = sorted([b for bad in VALBAD for b in bad], key=lambda x: -abs(x[2]))

                TDEV = [sum([v[it] for v in TRAINDEV], []) for it in range(len(TRAINX))]
                TUSE = [it for it in range(len(TRAINX)) if len(TDEV[it]) > 0]
                VT   = np.array([app.tools.validationMeasure(TDEV[it], opts.VALIDATIONMEASURE) for it in TUSE])

                fplots = app.tools.plotValidation(VALP[USE], V, pnames, VALDIR, errs=opts.ERRS, threshold=DEVTHRESHOLD, measure=opts.VALIDATIONMEASURE, uselog=opts.VALIDATIONLOG,
                                                  train=TRAINX[TUSE], trainV=VT, valpull=sum(VALPULL, []), trainpull=sum(TRAINPULL, []))

                fbad = os.path.join(VALDIR, "{}_validation.txt".format(os.path.splitext(os.path.basename(opts.OUTPUT))[0]))
                with open(fbad, "w") as f:
                    cols = ["binid", "relative_error", "absdev", "staterr"] if opts.ERRS else ["binid", "standardised_error", "absdev", "relative_error", "staterr"]
                    f.write("# {}\n".format("\t".join(cols + ["run"])))
                    for badBinId, iv, dev, absdev, reldev, staterr in BAD:
                        row = "{:.4f}\t{:.6e}\t{:.6e}".format(dev, absdev, staterr) if opts.ERRS else "{:.4f}\t{:.6e}\t{:.4f}\t{:.6e}".format(dev, absdev, reldev, staterr)
                        f.write("{}\t{}\t{}\n".format(badBinId, row, GRIDPATHS.get(tuple(VALP[iv]), "unknown")))

                if opts.ERRS:
                    print("Validation: mean relative error deviation {:.3f} over {} bins".format(np.mean(D), len(D)))
                else:
                    print("Validation: {}/{} validation points below {} sigma, worst {:.2f} sigma".format(np.sum(V<DEVTHRESHOLD), len(V), DEVTHRESHOLD, np.max(V)))
                print("Validation: {}/{} bins deviate by more than {}, written to {}".format(len(BAD), len(D), DEVTHRESHOLD, fbad))
                print("Validation: {} scatter plots and distributions written to {}".format(len(fplots), VALDIR))

    exit(0)
